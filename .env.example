# Copy to .env (or fim2chat.env for `docker run --env-file`) and edit.
# Every setting here is also a command-line flag; a flag overrides the variable.
# Keep comments on their own lines: `docker run --env-file` does not strip
# inline "# comments" and would treat them as part of the value.
# Booleans accept: true, false (also 1, 0).

# --- Required -----------------------------------------------------------------
# Full URL of the upstream chat endpoint.
CORP_API_URL=https://.../v1/chat/completions
# Upstream API key. If empty, the key your editor sends is forwarded.
CORP_API_KEY=your-key
# Model name sent upstream. If empty, the model your editor sends is used.
CORP_API_MODEL=@personal-openai/gpt-6-luna

# --- Upstream request ---------------------------------------------------------
# Header that carries the key. Possible values:
#   Authorization      sends "Bearer <key>" (default)
#   any other name     sends the raw key in that header, e.g. api-key (Azure),
#                      x-portkey-api-key (Portkey)
FIM_AUTH_HEADER=x-portkey-api-key

# Name of the token-limit field in the request body. Possible values:
#   max_tokens                (default; older models)
#   max_completion_tokens     (GPT-5.x / GPT-6 / o-series)
FIM_MAX_TOKENS_FIELD=max_completion_tokens

# Max tokens when the editor sends no limit. A positive integer (default 256).
# FIM_MAX_TOKENS=256

# Sampling temperature: a number such as 0 (default) or 0.2. A negative value
# (-1) omits the field, which some reasoning models require.
# FIM_TEMPERATURE=0

# JSON object merged into the upstream request body, overriding other fields.
# FIM_EXTRA_BODY={"reasoning_effort":"none"}

# Extra upstream headers as "Name: value", several separated by ";".
# FIM_HEADERS=x-portkey-provider: @your-provider

# Also send the editor's stop sequences upstream. Possible values: true, false (default).
# FIM_SEND_STOP=false

# Upstream request timeout: a duration such as 500ms, 10s, 2m (default 30s;
# this example sets a tighter 10s, which suits completions from a fast model).
FIM_TIMEOUT=10s

# --- Network and TLS ----------------------------------------------------------
# Address to listen on, host:port (default 127.0.0.1:8787). Inside Docker the
# image already sets 0.0.0.0:8787; publish the port on 127.0.0.1 only.
# FIM_LISTEN=127.0.0.1:8787

# Public CAs work out of the box. Only if your gateway or network (e.g. Zscaler
# TLS inspection) uses a private root CA: place its PEM in ./certs/ and set:
# FIM_CA_CERT=/certs/corp-root.pem

# Skip TLS verification entirely. Possible values: true, false (default).
# Last resort only; prefer FIM_CA_CERT.
# FIM_INSECURE=false

# --- Access control -----------------------------------------------------------
# Always on, no setting needed: requests from web pages (any request with an
# Origin header) and requests whose Host is not localhost or an IP address are
# refused, so a browser tab cannot spend your API key's quota.

# Optional shared secret. When set, the editor must send it as
# "Authorization: Bearer <token>" (put it in the API key field of the Zed
# provider). Needs CORP_API_KEY, so the token itself is never sent upstream.
# Use a long random value (16+ characters), e.g. from: openssl rand -hex 24
# FIM_AUTH_TOKEN=

# Extra host names accepted in the Host header, comma-separated, without port.
# Needed only if the editor reaches the proxy under a name, e.g. another machine
# using a LAN name. Possible values: names like proxy.lan,devbox; or * to turn
# the Host check off (not recommended: it is the protection against DNS rebinding).
# FIM_ALLOWED_HOSTS=

# --- Limits -------------------------------------------------------------------
# Largest request body accepted from the editor, in bytes (default 1048576 = 1 MiB).
# Larger requests are logged as truncated and rejected with 413.
# FIM_MAX_BODY_BYTES=1048576

# Largest upstream response read, in bytes (default 4194304 = 4 MiB).
# A larger response is logged and fails with 502.
# FIM_MAX_RESPONSE_BYTES=4194304

# --- Output handling ----------------------------------------------------------
# Disable clean-up of the model output (code fences, echoed text...).
# Rewrite replies still use a no-change fallback for truncated or blank answers.
# Possible values: true, false (default).
# FIM_RAW=false

# Path to a file whose content replaces the built-in FIM system prompt only.
# Edit formats (zeta, zeta2, sweep) always use built-in rewrite instructions.
# FIM_SYSTEM_PROMPT_FILE=

# --- Logging ------------------------------------------------------------------
# Log verbosity. Possible values (case-insensitive):
#   debug   everything, including request/response bodies and headers
#           (this contains your source code; do not send it to shared storage)
#   info    every request, upstream call, and response, without bodies (default)
#   warn    problems only: rejected requests, upstream 4xx/5xx, redirects
#   error   failures only
# FIM_LOG_LEVEL=info

# Log output format. Possible values:
#   text    key=value lines (default)
#   json    one JSON object per line, for log collectors
# FIM_LOG_FORMAT=text
